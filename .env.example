# GridWise LLM Configuration
# Copy this file to .env and configure your values

# Service network configuration (must bind to 0.0.0.0 for Docker container)
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration
# Supported providers: OpenAI, Google Gemini, Groq, or any OpenAI-compatible API
# Leave blank to use deterministic offline fallback for local evaluations
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Latency budget configuration (seconds)
LLM_TIMEOUT_SECONDS=8.0

# Allow offline fallback if LLM times out or key is not provided
ALLOW_HEURISTIC_FALLBACK=true
